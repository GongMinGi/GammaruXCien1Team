%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d59e935ae2b8484449b223c59cf74675, type: 3}
  m_Name: Dialogue_Stage1Intro
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: {fileID: 11400000, guid: 70f5759716fcae140837bf24b8104309, type: 2}
    backgroundIllustration: {fileID: -6639020553877026472, guid: 37992745ef5694447a04875827da8f55, type: 3}
    expressionName: Laughter
    hidesSpeakerIllustration: 1
    text: "\uBA3C \uC61B\uB0A0, \uD574, \uB2EC, \uBCC4, \uADF8\uB9AC\uACE0 \uC544\uB974\uCE74\uB098\uC758
      \uD798\uC744 \uC0AC\uC6A9\uD574 \uC6B4\uBA85\uC744 \uBCF4\uB294 \uD55C \uBA85\uC758
      \uC810\uC131\uC220\uC0AC\uAC00 \uB4F1\uC7A5\uD588\uC2B5\uB2C8\uB2E4."
  - speaker: {fileID: 11400000, guid: 70f5759716fcae140837bf24b8104309, type: 2}
    backgroundIllustration: {fileID: -6639020553877026472, guid: 37992745ef5694447a04875827da8f55, type: 3}
    expressionName: Laughter
    hidesSpeakerIllustration: 1
    text: "\uADF8\uB294 \uC810\uC131\uC220\uC744 \uD1B5\uD574 \uC655\uAD6D\uC744
      \uBC88\uC601\uC73C\uB85C \uC774\uB04C\uC5C8\uC73C\uB098, \uC5B4\uB290 \uB0A0
      \uC544\uBB34 \uB9D0 \uC5C6\uC774 \uC0AC\uB77C\uC84C\uC2B5\uB2C8\uB2E4."
  - speaker: {fileID: 11400000, guid: 70f5759716fcae140837bf24b8104309, type: 2}
    backgroundIllustration: {fileID: -6639020553877026472, guid: 37992745ef5694447a04875827da8f55, type: 3}
    expressionName: Laughter
    hidesSpeakerIllustration: 1
    text: "\uADF8\uB97C \uBCF4\uACE0 \uC6B4\uBA85\uC758 \uAE38\uC744 \uAC77\uAC8C
      \uB41C \uC218\uB9CE\uC740 \uC810\uC131\uC220\uC0AC\uB4E4\uC740 \uADF8\uB97C
      \uC804\uC124 \uC18D\uC758 \uC810\uC131\uC220\uC0AC, \uCCAB \uBC88\uC9F8 \uC810\uC220\uAC00\uB85C
      \uCE6D\uD588\uC2B5\uB2C8\uB2E4."
  - speaker: {fileID: 11400000, guid: 70f5759716fcae140837bf24b8104309, type: 2}
    backgroundIllustration: {fileID: 3881294057974534084, guid: fa3ef9947ef499a41aeb8f7a5d2e9f6a, type: 3}
    expressionName: Laughter
    hidesSpeakerIllustration: 1
    text: "\uC2DC\uAC04\uC740 \uD750\uB974\uACE0, \uC218\uB9CE\uC740 \uC218\uC815\uAD6C\uB4E4\uC758
      \uBE5B\uC774 \uAEBC\uC9C4 \uC9C0\uAE08. \uB9C8\uC9C0\uB9C9 \uC810\uC131\uC220\uC0AC\uC778
      \uC140\uB808\uB124\uB294 \uBB34\uC218\uD55C \uD30C\uBA78\uC758 \uBBF8\uB798\uB97C
      \uBCF4\uAC8C \uB429\uB2C8\uB2E4."
  - speaker: {fileID: 11400000, guid: 70f5759716fcae140837bf24b8104309, type: 2}
    backgroundIllustration: {fileID: 4834539639597328114, guid: 881a9a411bce69d4b8de2461ae7b177b, type: 3}
    expressionName: Laughter
    hidesSpeakerIllustration: 1
    text: "\uD30C\uBA78\uC744 \uB9C9\uAE30 \uC704\uD574 \uBCC4\uC744 \uB530\uB77C
      \uD55C \uC720\uC801\uC5D0 \uB3C4\uCC29\uD55C \uC140\uB808\uB124\uB294 \uBC84\uB824\uC9C4
      \uACE8\uB818\uACFC, \uADF8\uAC83\uC774 \uC9C0\uD0A4\uB358 \uACE0\uB300 \uC11C\uC801\uC744
      \uBCF4\uAC8C \uB429\uB2C8\uB2E4\u2026"
  - speaker: {fileID: 11400000, guid: 70f5759716fcae140837bf24b8104309, type: 2}
    backgroundIllustration: {fileID: 0}
    expressionName: Default
    hidesSpeakerIllustration: 0
    text: "\uC548\uB155, \uB098\uB294 \uC140\uB808\uB124\uC57C"
  - speaker: {fileID: 11400000, guid: 70f5759716fcae140837bf24b8104309, type: 2}
    backgroundIllustration: {fileID: 0}
    expressionName: Laughter
    hidesSpeakerIllustration: 0
    text: "\uC2A4\uD14C\uC774\uC9C0\uB97C \uD074\uB9AD\uD574\uBCFC\uB798?"
